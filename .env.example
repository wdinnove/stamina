# ============================================================
# Modèle de configuration — copier en `.env` et remplir.
#   cp .env.example .env
# `.env` est ignoré par Git. Ce fichier-ci ne doit JAMAIS contenir de valeur réelle.
#
# Toute variable préfixée VITE_ est embarquée dans le bundle JavaScript et donc
# PUBLIQUE. Aucun secret ne doit porter ce préfixe.
#
# Les mêmes variables doivent être déclarées dans Vercel
# (Settings → Environment Variables) pour la production.
# ============================================================


# ── Supabase ────────────────────────────────────────────────
# Project Settings → API

# Public. « Project URL ».
VITE_SUPABASE_URL=

# Public par conception (visible dans le navigateur). Clé « anon / public ».
# Ce sont les policies RLS qui protègent les données, pas cette clé.
VITE_SUPABASE_ANON_KEY=

# SECRET — contourne toute la RLS. Usage serverless (api/) uniquement.
# Jamais de préfixe VITE_ ici. Clé « service_role / secret ».
SUPABASE_SERVICE_ROLE_KEY=


# ── Google OAuth (connexion « avec Google ») ────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Le Client Secret se saisit côté Supabase (Authentication → Providers → Google),
# pas ici.
VITE_GOOGLE_CLIENT_ID=


# ── MailerSend (emails sortants) ────────────────────────────
# SECRET.
MAILERSEND_API_KEY=
MAILERSEND_FROM_EMAIL=
MAILERSEND_FROM_NAME=
# Note : le template des emails joueur (bien-être et questionnaire de personnalité,
# variables `name` et `url`) est codé en dur dans api/_lib/mailer.js — ni secret, ni
# variable d'un déploiement à l'autre.
# Adresse vers laquelle partent les RÉPONSES aux emails envoyés.
# Le domaine expéditeur n'a besoin que des enregistrements d'envoi (SPF, DKIM,
# return-path) : sans MX, il ne reçoit rien, et une réponse d'un joueur se
# perdrait. Mettre ici une adresse réellement relevée (la tienne suffit).
MAIL_REPLY_TO=


# ── Web Push / VAPID (notifications mobiles) ────────────────
# Générer la paire avec :  npx web-push generate-vapid-keys
# Reporter aussi ces valeurs dans les variables d'environnement Vercel.

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=          # SECRET
VAPID_SUBJECT=mailto:

# Même valeur que VAPID_PUBLIC_KEY, exposée au navigateur pour l'abonnement push.
VITE_VAPID_PUBLIC_KEY=


# ── Cron Vercel ─────────────────────────────────────────────
# SECRET. Générer avec :  openssl rand -hex 32
# Vercel l'envoie dans l'en-tête Authorization des appels cron ; sans lui,
# l'endpoint /api/cron/* refuse de s'exécuter.
CRON_SECRET=


# ── Origine publique de l'application ───────────────────────
# Utilisée pour construire le lien du formulaire bien-être envoyé aux joueurs.
# Volontairement JAMAIS déduite des en-têtes de la requête : un en-tête Host
# falsifié enverrait les joueurs vers un domaine ressemblant.
#
# À renseigner avec le domaine réel du club (ex. https://stamina.monclub.fr).
# À défaut, Vercel fournit VERCEL_PROJECT_PRODUCTION_URL, mais celui-ci pointe
# sur le domaine *.vercel.app : les joueurs recevraient un lien sur une adresse
# qu'ils ne reconnaissent pas.
#
# En local (vercel dev) :  http://localhost:3000
APP_ORIGIN=
